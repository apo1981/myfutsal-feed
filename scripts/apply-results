#!/bin/sh
# Aplica en bloque un CSV `id,home,away` rellenado por el operador y verifica el resultado (US-007b2c, D-180).
# Uso: scripts/apply-results <fichero.csv> [--updated-at AAAA-MM-DDTHH:MM:SSZ]
# No hace commit ni push: despues, `git diff`, `git commit` (con el tiempo) y `git push origin main`.
set -eu
. "$(dirname "$0")/_env.sh"
run_python "$FEED/scripts/apply_results.py" --feed "$FEED" "$@"
"$FEED/scripts/verify"
