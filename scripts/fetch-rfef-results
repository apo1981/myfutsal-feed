#!/bin/sh
# Descarga una jornada de la web de la RFEF y genera el CSV `id,home,away` de los partidos finalizados (US-034, ADR-011/012).
# No escribe el JSON del feed ni publica: el CSV se aplica despues con scripts/apply-results.
# Uso: scripts/fetch-rfef-results --phase apertura|clausura --round N [--out fichero.csv] [--from-file respuesta.json]
set -eu
. "$(dirname "$0")/_env.sh"
run_python "$FEED/scripts/fetch_rfef_results.py" --feed "$FEED" "$@"
